{
    "name": "Analytics",
    "enabled": true,
    "requires": [
        "Tenancy",
        "Connections",
        "Catalog",
        "Admin"
    ],
    "provider": "AnalyticsServiceProvider",
    "features": [
        { "name": "collect", "default": true }
    ],
    "settings": [
        { "name": "attribution_days", "type": "int", "default": 7, "min": 1, "max": 30, "scope": "shop", "unit": "days" },
        { "name": "beacons_per_minute", "type": "int", "default": 120, "min": 10, "max": 2000, "scope": "global", "unit": "requests" },
        { "name": "retention_days", "type": "int", "default": 400, "min": 30, "max": 3650, "scope": "global", "unit": "days" }
    ]
}
