{
    "name": "Widget",
    "enabled": true,
    "requires": [
        "Tenancy",
        "Connections",
        "Catalog",
        "Enrichment",
        "Admin"
    ],
    "provider": "WidgetServiceProvider",
    "features": [
        { "name": "on_products", "default": true },
        { "name": "on_content", "default": true }
    ],
    "settings": [
        { "name": "product_selector", "type": "string", "default": "form.cart", "min": 1, "max": 200, "scope": "shop" },
        { "name": "product_position", "type": "enum", "options": ["after", "before", "prepend", "append"], "default": "after", "scope": "shop" },
        { "name": "content_selector", "type": "string", "default": ".entry-content", "min": 1, "max": 200, "scope": "shop" },
        { "name": "content_position", "type": "enum", "options": ["after", "before", "prepend", "append"], "default": "after", "scope": "shop" },
        { "name": "floating_fallback", "type": "bool", "default": true, "scope": "shop" },
        { "name": "max_products", "type": "int", "default": 4, "min": 1, "max": 12, "scope": "shop", "unit": "products" },
        { "name": "page_cache_seconds", "type": "int", "default": 300, "min": 0, "max": 86400, "scope": "global", "unit": "seconds" },
        { "name": "page_requests_per_minute", "type": "int", "default": 240, "min": 10, "max": 5000, "scope": "global", "unit": "requests" }
    ]
}
