{
    "name": "Enrichment",
    "enabled": true,
    "requires": [
        "Tenancy",
        "Runs",
        "Catalog",
        "Admin",
        "Ai"
    ],
    "provider": "EnrichmentServiceProvider",
    "features": [
        {
            "name": "auto_approve",
            "default": true
        }
    ],
    "settings": [
        {
            "name": "max_requests_per_task_file",
            "type": "int",
            "default": 400,
            "min": 1,
            "max": 5000,
            "scope": "shop",
            "unit": "requests"
        },
        {
            "name": "max_agent_text_chars",
            "type": "int",
            "default": 1000,
            "min": 300,
            "max": 8000,
            "scope": "shop",
            "unit": "characters"
        },
        {
            "name": "max_highlight_text_chars",
            "type": "int",
            "default": 3000,
            "min": 500,
            "max": 12000,
            "scope": "shop",
            "unit": "characters"
        },
        {
            "name": "max_products_per_article",
            "type": "int",
            "default": 6,
            "min": 1,
            "max": 24,
            "scope": "shop",
            "unit": "products"
        },
        {
            "name": "min_set_size",
            "type": "int",
            "default": 4,
            "min": 2,
            "max": 50,
            "scope": "shop",
            "unit": "products"
        },
        {
            "name": "max_upload_kilobytes",
            "type": "int",
            "default": 20000,
            "min": 100,
            "max": 100000,
            "scope": "global",
            "unit": "kilobytes"
        }
    ]
}
